{
	"name": "pinback-mcp",
	"version": "0.3.1",
	"description": "Local MCP server that lets your coding agent read visual-feedback comments pinned to web pages with the Pinback Chrome extension.",
	"type": "module",
	"bin": {
		"pinback-mcp": "dist/bin.js"
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"build": "node esbuild.mjs",
		"prepack": "node esbuild.mjs",
		"publish-alias": "node scripts/publish-alias.mjs"
	},
	"keywords": [
		"mcp",
		"model-context-protocol",
		"claude-code",
		"codex",
		"coding-agent",
		"feedback",
		"annotations",
		"chrome-extension"
	],
	"license": "SEE LICENSE IN LICENSE",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/andybiggs/pinback.git",
		"directory": "packages/mcp-server"
	},
	"homepage": "https://andybiggs.github.io/pinback/",
	"bugs": {
		"url": "https://github.com/andybiggs/pinback/issues"
	},
	"engines": {
		"node": ">=20"
	},
	"dependencies": {
		"@modelcontextprotocol/sdk": "^1.12.0",
		"zod": "^3.25.76"
	},
	"devDependencies": {
		"@pinback/shared": "*"
	}
}
